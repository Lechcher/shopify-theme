{%- comment -%}
  BKY - Reviews Section
  Merchant-authored reviews: aggregate rating + star distribution, a "Reviews with
  Images" gallery, star filter pills, and the review list. Clicking a review photo
  (in the gallery or in a review entry) opens it enlarged in a section-scoped image
  viewer with previous/next navigation and a reviewer caption. See
  openspec/changes/add-reviews-section for the base spec and design, and
  openspec/changes/add-review-image-viewer for the image-viewer spec and design.
{%- endcomment -%}

{%- liquid
  assign total = 0
  assign rating_sum = 0
  assign c5 = 0
  assign c4 = 0
  assign c3 = 0
  assign c2 = 0
  assign c1 = 0
  assign image_count = 0

  for block in section.blocks
    assign r = block.settings.rating | plus: 0
    assign total = total | plus: 1
    assign rating_sum = rating_sum | plus: r
    if block.settings.image != blank
      assign image_count = image_count | plus: 1
    endif
    if block.settings.image_2 != blank
      assign image_count = image_count | plus: 1
    endif
    if block.settings.image_3 != blank
      assign image_count = image_count | plus: 1
    endif
    if r == 5
      assign c5 = c5 | plus: 1
    elsif r == 4
      assign c4 = c4 | plus: 1
    elsif r == 3
      assign c3 = c3 | plus: 1
    elsif r == 2
      assign c2 = c2 | plus: 1
    elsif r == 1
      assign c1 = c1 | plus: 1
    endif
  endfor

  assign avg = 0
  assign avg_pct = 0
  assign p5 = 0
  assign p4 = 0
  assign p3 = 0
  assign p2 = 0
  assign p1 = 0
  if total > 0
    assign avg = rating_sum | times: 1.0 | divided_by: total
    assign avg_pct = avg | times: 20 | round: 1
    assign p5 = c5 | times: 100.0 | divided_by: total | round: 1
    assign p4 = c4 | times: 100.0 | divided_by: total | round: 1
    assign p3 = c3 | times: 100.0 | divided_by: total | round: 1
    assign p2 = c2 | times: 100.0 | divided_by: total | round: 1
    assign p1 = c1 | times: 100.0 | divided_by: total | round: 1
  endif
  assign avg_display = avg | round: section.settings.rating_decimals
  assign total_pages = total | plus: 2 | divided_by: 3
-%}

